---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CloudTerminal from '../components/CloudTerminal.astro';
import LectureCard from '../components/LectureCard.astro';
import { domainMeta, publishedLectures } from '../lib/lectures';
import { withBase } from '../lib/urls';

const lectures = publishedLectures(await getCollection('lectures'));
const domains = Object.values(domainMeta);
---

<BaseLayout>
  <Header floating />
  <main id="main-content">
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <p class="hero-kicker">Independent study guide / SAA-C03</p>
        <h1 id="hero-title">AWS SAA,<br />decoded<em>.</em></h1>
        <div class="hero-bottomline">
          <p class="hero-subtitle">Clear architecture thinking for the associate exam—without the service-catalog noise.</p>
          <div class="hero-byline">
            <span class="hero-avatar" aria-hidden="true">SAA</span>
            <span>{lectures.length} field notes<br />built from the exam blueprint</span>
          </div>
        </div>
        <div class="hero-rule"></div>
        <div class="hero-statline">
          <span>secure · resilient · performant · cost-aware</span>
          <span>system ready</span>
        </div>
        <CloudTerminal />
      </div>
      <a class="scroll-cue" href="#start"><i></i><span>Begin</span></a>
    </section>

    <section class="section section--first" id="start">
      <div class="container" data-reveal>
        <div class="section-intro">
          <p class="section-kicker">The premise</p>
          <div>
            <h2 class="display-copy">The exam is not asking which service you remember. It is asking which <em>trade-off</em> you see.</h2>
            <p class="prose-lead">These lectures turn AWS features into decision rules: what the requirement signals, which option fits, and why the tempting alternatives do not.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="domains">
      <div class="container">
        <div class="section-heading-row" data-reveal>
          <div>
            <p class="section-kicker">Exam map</p>
            <h2>Four domains.<br />One mental model.</h2>
          </div>
          <p>The official SAA-C03 weighting gives you a practical way to prioritize your study time.</p>
        </div>
        <div class="domain-grid" data-reveal>
          {domains.map((domain) => (
            <article class="domain-card">
              <div class="domain-card-top">
                <span>Domain {domain.number}</span>
                <strong>{domain.weight}</strong>
              </div>
              <h3>{domain.label}</h3>
              <p>{domain.description}</p>
              <div class="domain-meter" aria-label={`${domain.weight} of scored content`}>
                <span style={`width:${domain.weight}`}></span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="latest">
      <div class="container">
        <div class="section-heading-row" data-reveal>
          <div>
            <p class="section-kicker">The curriculum</p>
            <h2>Start with the<br />architecture.</h2>
          </div>
          <p>Read in order or jump to the domain that needs work. Your completion state stays in this browser.</p>
        </div>
        <div class="lecture-list" data-reveal>
          {lectures.slice(0, 6).map((lecture) => <LectureCard lecture={lecture} />)}
        </div>
        <div class="list-footer">
          <a class="text-link" href={withBase('/lectures/')}>View the complete lecture library <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="publish-panel" data-reveal>
          <div class="publish-copy">
            <p class="section-kicker">Markdown first</p>
            <h2>Publish by writing.</h2>
            <p>Add a plain <code>.md</code> file, give it a few frontmatter fields, and the lecture appears here with its own route, metadata, navigation, and RSS entry.</p>
            <a class="text-link" href={withBase('/lectures/')}>Explore the rendered notes <span aria-hidden="true">↗</span></a>
          </div>
          <div class="publish-code" aria-label="Example Markdown frontmatter">
            <div class="publish-code-label">src/content/lectures/your-lecture.md</div>
            <pre><span class="dash">---</span>
<span class="key">title:</span> <span class="value">"Your lecture title"</span>
<span class="key">description:</span> <span class="value">"One clear promise."</span>
<span class="key">order:</span> 7
<span class="key">domain:</span> <span class="value">"resilient"</span>
<span class="key">publishedAt:</span> 2026-09-02
<span class="key">tags:</span> [<span class="value">"sqs"</span>, <span class="value">"decoupling"</span>]
<span class="dash">---</span>

## The exam-sized idea

Write normal Markdown from here.</pre>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    try {
      const completed = JSON.parse(localStorage.getItem('saa-completed') || '[]');
      document.querySelectorAll('[data-lecture-card]').forEach((card) => {
        if (completed.includes(card.dataset.id)) card.classList.add('is-complete');
      });
    } catch {}
  </script>
</BaseLayout>
